# Copy to config/keys.env (extension) and/or backend/.env (Flask server)
# Get Gemini key: https://aistudio.google.com/apikey
# Get ElevenLabs key: https://elevenlabs.io/

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
DEFAULT_ELEVENLABS_VOICE_ID=your-voice-id
VEGETA_VOICE_ID=your-voice-id
FRIERAN_VOICE_ID=
ZOEY_VOICE_ID=
FRENLIN_BACKEND_URL=http://127.0.0.1:5001/respond
