{
  "name": "mommyasmr-ai",
  "displayName": "MOMMY ASMR",
  "description": "A voice-to-voice AI coding companion.",
  "version": "0.2.0",
  "publisher": "mommyasmr",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "MOMMY ASMR",
      "properties": {
        "mommyasmr.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5001/respond",
          "description": "Flask backend endpoint that receives transcripts and returns a response payload."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mommyasmr-sidebar",
          "title": "MOMMY ASMR",
          "icon": "media/icons/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "mommyasmr-sidebar": [
        {
          "type": "webview",
          "id": "mommyasmr.companion",
          "name": "Companion"
        }
      ]
    },
    "commands": [
      { "command": "mommyasmr.openPanel",          "title": "Open Companion",             "category": "MOMMY ASMR" },
      { "command": "mommyasmr.newConversation",     "title": "New Conversation",           "category": "MOMMY ASMR" },
      { "command": "mommyasmr.deleteConversation",  "title": "Delete Conversation",        "category": "MOMMY ASMR" },
      { "command": "mommyasmr.toggleHistory",       "title": "Toggle Session History",     "category": "MOMMY ASMR" },
      { "command": "mommyasmr.switchProfile",       "title": "Switch Voice Profile",       "category": "MOMMY ASMR" },
      { "command": "mommyasmr.openMicSettings",      "title": "Open Microphone Settings",   "category": "MOMMY ASMR" }
    ],
    "keybindings": [
      { "command": "mommyasmr.openPanel", "key": "ctrl+shift+m", "mac": "cmd+shift+m" }
    ]
  },
  "scripts": {
    "compile":          "tsc -p ./tsconfig.json && tsc -p ./tsconfig.webview.json",
    "watch":            "tsc -watch -p ./tsconfig.json",
    "vscode:prepublish":"npm run compile"
  },
  "devDependencies": {
    "@types/vscode":                     "^1.85.0",
    "@types/node":                       "^18.0.0",
    "@typescript-eslint/eslint-plugin":  "^6.0.0",
    "@typescript-eslint/parser":         "^6.0.0",
    "eslint":                            "^8.0.0",
    "typescript":                        "^5.0.0"
  }
}
